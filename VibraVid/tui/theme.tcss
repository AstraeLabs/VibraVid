/* ── VibraVid TUI — Tokyo Night Modern Design System ──────────────────────
   Built following the tui-design skill standards:
   - Semantic color slots (bg.base, bg.surface, bg.overlay, fg.default, status.*)
   - Background layering for depth (no unnecessary harsh borders)
   - Clear focus management and visual indicators
   - High information density with crisp typography
   ──────────────────────────────────────────────────────────────────────── */

/* ── Color System ──────────────────────────────────────────────────────── */

$bg-base: #1a1b26;
$bg-surface: #24283b;
$bg-overlay: #2f3549;
$bg-selection: #3b4261;

$fg-default: #c0caf5;
$fg-muted: #565f89;
$fg-emphasis: #7aa2f7;

$accent-primary: #7aa2f7;
$accent-secondary: #bb9af7;

$status-success: #9ece6a;
$status-warning: #e0af68;
$status-error: #f7768e;
$status-info: #7dcfff;

/* Category badges */
$cat-anime: #f7768e;
$cat-film_serie: #e0af68;
$cat-serie: #9ece6a;
$cat-song: #9d7cd8;
$cat-tor: #7dcfff;
$cat-global: #bb9af7;

/* ── Global Elements ──────────────────────────────────────────────────── */

Screen {
    background: $bg-base;
    color: $fg-default;
}

Header {
    background: $bg-surface;
    color: $fg-emphasis;
    dock: top;
    height: 1;
}

Footer, CustomFooter {
    background: #1f2335;
    color: #c0caf5;
    dock: bottom;
    height: 1;
    padding: 0 1;
    border: none;
}

Button {
    background: $bg-surface;
    color: $fg-default;
    border: round $bg-overlay;
    min-width: 12;
    height: 3;
    padding: 0 1;
}

Button:hover {
    background: $bg-overlay;
    color: $fg-emphasis;
    border: round $accent-primary;
}

Button:focus {
    background: $accent-primary;
    color: #15161e;
    text-style: bold;
    border: round $accent-primary;
}

Button.-primary {
    background: $accent-primary;
    color: #15161e;
    text-style: bold;
}

Button.-error {
    background: $status-error;
    color: #15161e;
    text-style: bold;
}

Button.-warning {
    background: $status-warning;
    color: #15161e;
    text-style: bold;
}

Input {
    background: $bg-surface;
    color: $fg-default;
    border: round $bg-overlay;
    height: 3;
    padding: 0 1;
}

Input:focus {
    border: round $accent-primary;
    background: $bg-surface;
}

DataTable {
    background: $bg-base;
    color: $fg-default;
}

DataTable > .datatable--header {
    background: $bg-surface;
    color: $accent-primary;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $bg-selection;
    color: #ffffff;
    text-style: bold;
}

OptionList {
    background: $bg-base;
    color: $fg-default;
    border: round $bg-overlay;
}

OptionList:focus {
    border: round $accent-primary;
}

OptionList > .option-list--option-highlighted {
    background: $bg-selection;
    color: $fg-emphasis;
    text-style: bold;
}

/* ── Category Styling ─────────────────────────────────────────────────── */

.cat-anime { color: $cat-anime; text-style: bold; }
.cat-film_serie { color: $cat-film_serie; text-style: bold; }
.cat-serie { color: $cat-serie; text-style: bold; }
.cat-song { color: $cat-song; text-style: bold; }
.cat-tor { color: $cat-tor; text-style: bold; }
.cat-global { color: $cat-global; text-style: bold; }

/* ── Home Screen Search Engine Card Layout ────────────────────────────── */

#home-outer {
    align: center middle;
    padding: 1 2;
}

#home-card {
    width: 104;
    max-width: 95%;
    height: auto;
    border: round $accent-primary;
    background: $bg-surface;
    padding: 1 3;
}

#home-logo {
    text-align: center;
    margin-bottom: 0;
}

#home-tagline {
    text-align: center;
    margin-bottom: 1;
}

#home-search-bar {
    height: 3;
    margin-bottom: 1;
    align: center middle;
}

#main-search-input {
    width: 4fr;
    height: 3;
    margin-right: 1;
}

#btn-submit-search {
    width: 1fr;
    min-width: 14;
    height: 3;
}

.home-section-title {
    text-style: bold;
    color: $accent-primary;
    margin-top: 1;
    margin-bottom: 1;
    text-align: center;
}

#home-provider-filter-bar {
    height: 3;
    margin-bottom: 1;
    align: center middle;
}

#provider-filter-input {
    width: 1fr;
    height: 3;
}

/* Five pills side by side leave 8 usable cells each on an 80 column terminal,
   which is not enough for the labels: below that width they wrap onto two rows. */
#home-scope-pills {
    height: 3;
    margin-bottom: 1;
    grid-size: 5;
    grid-columns: 1fr 1fr 1fr 1fr 1fr;
    grid-rows: 3;
    grid-gutter: 0 1;
}

#home-scope-pills.-narrow {
    grid-size: 3;
    height: 6;
    grid-gutter: 0 1;
}

.scope-pill {
    width: 1fr;
    height: 3;
    margin: 0;
}

#home-sites-box {
    height: auto;
    max-height: 10;
    border: round $bg-overlay;
    background: $bg-base;
    padding: 1 2;
    margin-bottom: 1;
}

#home-sites-wrap {
    height: auto;
    max-height: 8;
}

.site-pill-row {
    height: 1;
    margin-bottom: 0;
    align: center middle;
}

.site-dot {
    color: $fg-muted;
    width: 3;
    content-align: center middle;
}

Button.site-pill {
    min-width: 0;
    height: 1;
    padding: 0 1;
    margin: 0;
    border: none;
    background: transparent;
    color: $fg-default;
}

Button.site-pill:hover {
    color: $accent-primary;
    background: $bg-overlay;
    border: none;
}

Button.site-pill:focus {
    color: $accent-primary;
    text-style: bold underline;
    background: $bg-selection;
    border: none;
}

Button.site-pill.-primary {
    background: $accent-primary;
    color: #15161e;
    text-style: bold;
    border: none;
}

/* ── Search Screen ────────────────────────────────────────────────────── */

#search-panel {
    padding: 1 2;
}

#search-inputs-bar {
    height: auto;
    margin-bottom: 1;
}

#search-inputs-bar Input#query {
    width: 2fr;
    margin-right: 1;
}

#search-inputs-bar Input#year {
    width: 1fr;
}

/* Grid rather than a row: the pills share the width instead of overflowing it
   when the labels or the counters grow. */
#category-filter-pills {
    height: auto;
    margin-bottom: 1;
    grid-size: 4;
    grid-columns: 1fr 1fr 1fr 1fr;
    grid-rows: 3;
    grid-gutter: 0 1;
}

.filter-pill {
    width: 1fr;
    height: 3;
    margin: 0;
}

#sort-btn {
    min-width: 16;
    height: 3;
    margin-left: 1;
    background: $bg-surface;
    color: $accent-primary;
    border: round $accent-primary;
}

#retry-failed-btn {
    min-width: 16;
    height: 3;
    margin-left: 1;
}

#search-loading {
    height: 3;
}

#search-status {
    color: $fg-muted;
    padding-bottom: 1;
}

#search-split {
    height: 1fr;
}

#results-container {
    width: 55%;
    height: 1fr;
    padding-right: 1;
}

#batch-actions-bar {
    height: 3;
    margin-top: 1;
    align: left middle;
    background: $bg-surface;
    padding: 0 1;
    border: round $status-success;
}

#batch-count-label {
    width: auto;
    margin-right: 2;
    text-style: bold;
    color: $status-success;
}

#btn-batch-enqueue {
    margin-right: 1;
    height: 3;
}

#btn-batch-clear {
    height: 3;
}

#preview-container {
    width: 45%;
    height: 1fr;
}

#preview-box {
    height: 1fr;
    border: round $accent-primary;
    background: $bg-surface;
    padding: 1 2;
}

#search-preview-box {
    height: auto;
    max-height: 14;
    margin-bottom: 1;
}

#preview-providers-box {
    height: auto;
    margin-bottom: 1;
}

.preview-prov-title {
    text-style: bold;
    color: $accent-primary;
    margin-bottom: 0;
}

/* Same grid treatment as the action row: the provider pills are created on demand,
   so a plain row would overflow the column as soon as a title has several of them. */
#preview-providers-wrap {
    height: auto;
    margin-top: 0;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: 3;
    grid-gutter: 0 1;
}

.preview-prov-pill {
    width: 1fr;
    height: 3;
    margin: 0;
}

/* 2x2 grid: the buttons follow the width of the preview column instead of
   overflowing it, so none of them ends up cut off or off-screen. */
#preview-actions-row {
    height: auto;
    margin-top: 1;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: 3;
    grid-gutter: 0 1;
}

#preview-actions-row Button {
    width: 1fr;
    height: 3;
    margin: 0;
}

FuzzyList {
    height: 1fr;
    width: 1fr;
}

#fuzzy-input {
    dock: top;
    margin-bottom: 1;
}

#fuzzy-list {
    height: 1fr;
    width: 1fr;
}

/* ── Detail Screen ────────────────────────────────────────────────────── */

#detail-panel {
    padding: 1 2;
}

.detail-title {
    text-style: bold;
    color: $accent-primary;
    padding-top: 1;
}

.detail-meta {
    color: $fg-muted;
}

#series-area {
    height: 1fr;
    padding-top: 1;
}

#seasons-loading {
    height: 3;
}

#series-browser {
    height: 1fr;
}

#providers-box {
    width: 25%;
    border-right: solid $bg-overlay;
    background: $bg-surface;
    padding: 0 1;
}

#seasons-box {
    width: 25%;
    border-right: solid $bg-overlay;
    background: $bg-surface;
    padding: 0 1;
}

#episodes-box {
    width: 50%;
    padding: 0 1;
}

.box-title {
    text-style: bold;
    color: $accent-primary;
    padding: 0 1;
}

.dsl-preview {
    color: $status-warning;
    padding: 1 0;
    text-style: bold;
}

#actions-row {
    height: auto;
    padding: 1 0;
}

#actions-row Button {
    margin-right: 2;
}

/* ── Downloads Screen ─────────────────────────────────────────────────── */

#downloads-panel {
    padding: 1 2;
}

#downloads-table {
    height: 1fr;
    max-height: 45%;
    border: round $bg-overlay;
    margin-bottom: 1;
}

#downloads-table:focus {
    border: round $accent-primary;
}

#completed-table {
    height: 1fr;
    max-height: 45%;
    border: round $bg-overlay;
    margin-bottom: 1;
}

#completed-table:focus {
    border: round $accent-primary;
}

#tasks-table {
    height: 1fr;
    border: round $bg-overlay;
}

#tasks-table:focus {
    border: round $accent-primary;
}

#downloads-actions {
    height: auto;
    padding-top: 1;
}

#downloads-actions Button {
    margin-right: 2;
}

/* ── Settings Screen ──────────────────────────────────────────────────── */

#settings-sidebar {
    width: 26;
    dock: left;
    background: $bg-surface;
    border-right: solid $bg-overlay;
    padding: 1 1;
}

#settings-content {
    width: 1fr;
    padding: 1 2;
}

#settings-form {
    height: 1fr;
    padding: 1 0;
}

.settings-banner {
    border: round $status-warning;
    background: $bg-surface;
    color: $status-warning;
    padding: 1;
    margin-bottom: 1;
    text-style: bold;
}

.settings-field {
    height: auto;
    margin-bottom: 1;
    align: left middle;
}

.field-label {
    width: 32;
    text-style: bold;
    color: $accent-primary;
}

.sub-title {
    text-style: bold;
    color: $accent-primary;
    padding-top: 1;
    padding-bottom: 1;
}

#settings-actions {
    height: auto;
    padding: 1 0;
    align: left middle;
}

#settings-actions Button {
    margin-right: 1;
}

#settings-status {
    padding-left: 1;
    color: $status-success;
}

/* ── System Screen ────────────────────────────────────────────────────── */

#tab-deps, #tab-logs, #tab-updates {
    padding: 1 2;
}

#deps-table {
    height: auto;
    max-height: 12;
    border: round $bg-overlay;
    margin-bottom: 1;
}

#deps-table:focus {
    border: round $accent-primary;
}

#drm-box {
    height: auto;
    padding: 1;
    border: round $bg-overlay;
    background: $bg-surface;
    margin-bottom: 1;
}

#log-control-bar {
    height: auto;
    margin-bottom: 1;
    align: left middle;
}

#log-control-bar Button {
    margin-left: 2;
}

#log-layout {
    height: 1fr;
}

#log-file-list {
    width: 32;
    dock: left;
    background: $bg-surface;
    border-right: solid $bg-overlay;
}

#log-viewer {
    width: 1fr;
    height: 1fr;
    border: round $bg-overlay;
    background: $bg-base;
}

#log-viewer:focus {
    border: round $accent-primary;
}

#update-box {
    height: 1fr;
    padding: 1;
    border: round $bg-overlay;
    background: $bg-surface;
}

#system-info-text {
    margin-bottom: 1;
}

#update-status {
    padding-top: 1;
    color: $status-info;
}

/* ── Queue Screen ─────────────────────────────────────────────────────── */

#queue-panel {
    padding: 1 2;
}

#queue-table {
    height: 1fr;
    max-height: 50%;
    border: round $bg-overlay;
    margin-bottom: 1;
}

#queue-table:focus {
    border: round $accent-primary;
}

.queue-detail-box {
    height: 5;
    border: round $accent-primary;
    background: $bg-surface;
    padding: 0 1;
}

#queue-actions {
    height: auto;
    padding-top: 1;
}

#queue-actions Button {
    margin-right: 2;
}

/* ── History Screen ───────────────────────────────────────────────────── */

#history-panel {
    padding: 1 2;
}

#history-table {
    height: 1fr;
    max-height: 50%;
    border: round $bg-overlay;
    margin-bottom: 1;
}

#history-table:focus {
    border: round $accent-primary;
}

.history-detail-box {
    height: 5;
    border: round $accent-primary;
    background: $bg-surface;
    padding: 0 1;
}

#history-actions {
    height: auto;
    padding-top: 1;
}

#history-actions Button {
    margin-right: 2;
}

/* ── Overlay Modals & Help ────────────────────────────────────────────── */

PlaceholderScreen, HelpScreen, EnqueueModal, RangeSelectModal {
    align: center middle;
    background: rgba(15, 16, 22, 0.8);
}

#placeholder-box, #enqueue-modal-box, #range-modal-box {
    width: 68;
    max-width: 90%;
    height: auto;
    border: round $accent-primary;
    padding: 1 2;
    background: $bg-surface;
}

#help-box {
    width: 74;
    max-width: 95%;
    max-height: 85%;
    border: round $accent-primary;
    padding: 1 2;
    background: $bg-surface;
}

#help-scroll {
    max-height: 18;
}

.help-section-header {
    text-style: bold;
}

.placeholder-title {
    text-style: bold;
    color: $accent-primary;
    padding-bottom: 1;
}

.placeholder-milestone {
    color: $status-warning;
    padding-top: 1;
}

.placeholder-hint {
    color: $fg-muted;
    padding-top: 1;
}

#enqueue-input {
    margin: 1 0;
}

#modal-buttons {
    height: auto;
    padding-top: 1;
}

#modal-buttons Button {
    margin-right: 2;
}
