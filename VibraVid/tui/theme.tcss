/* ── VibraVid TUI — flat, minimal theme ───────────────────────────────────
   Near-black background, no boxes: structure comes from spacing, a muted
   secondary text colour and one violet accent. Rich markup in the Python
   files uses the same colours (VibraVid/tui/palette.py).
   ──────────────────────────────────────────────────────────────────────── */

$bg-base: #121212;
$bg-surface: #1a1a1d;
$bg-overlay: #242428;
$bg-selection: #2b2745;

$fg-default: #d4d4d8;
$fg-muted: #71717a;
$fg-emphasis: #ffffff;

$accent-primary: #a78bfa;
$accent-secondary: #c4b5fd;

/* the five theme colors: purple (accent above), cyan, yellow, green, red */
$status-success: #86efac;
$status-warning: #fde047;
$status-error: #f87171;
$status-info: #67e8f9;

$cat-anime: #f87171;
$cat-film_serie: #fde047;
$cat-serie: #86efac;
$cat-song: #a78bfa;
$cat-tor: #67e8f9;
$cat-global: #c4b5fd;

/* ── Base ─────────────────────────────────────────────────────────────── */

Screen {
    background: $bg-base;
    color: $fg-default;
}

* {
    scrollbar-size-vertical: 1;
    scrollbar-background: $bg-base;
    scrollbar-background-hover: $bg-base;
    scrollbar-background-active: $bg-base;
    scrollbar-color: $bg-overlay;
    scrollbar-color-hover: $fg-muted;
    scrollbar-color-active: $accent-primary;
}

CustomFooter {
    dock: bottom;
    height: auto;
    background: $bg-base;
    color: $fg-muted;
}

LoadingIndicator {
    background: $bg-base;
    color: $accent-primary;
}

/* ── Controls: flat chips and a single prompt line ────────────────────── */

Button {
    background: $bg-overlay;
    color: $fg-default;
    border: none;
    min-width: 8;
    height: 1;
    padding: 0 2;
}

Button:hover {
    background: $bg-selection;
    color: $fg-emphasis;
}

Button:focus {
    background: $bg-selection;
    color: $accent-secondary;
    text-style: bold underline;
}

Button.-primary {
    background: $accent-primary;
    color: $bg-base;
    text-style: bold;
}

Button.-primary:hover, Button.-primary:focus {
    background: $accent-secondary;
    color: $bg-base;
}

Button.-error {
    background: $status-error;
    color: $bg-base;
    text-style: bold;
}

Button.-warning {
    background: $status-warning;
    color: $bg-base;
    text-style: bold;
}

Button:disabled {
    background: $bg-surface;
    color: $fg-muted;
}

Input {
    background: $bg-surface;
    color: $fg-default;
    border: none;
    border-left: thick $bg-overlay;
    height: 1;
    padding: 0 1;
}

Input:focus {
    background: $bg-surface;
    border: none;
    border-left: thick $accent-primary;
}

Input > .input--placeholder {
    color: $fg-muted;
}

Switch {
    background: $bg-base;
    border: none;
    padding: 0 1;
    height: 1;
}

Switch > .switch--slider {
    color: $fg-muted;
    background: $bg-overlay;
}

Switch.-on > .switch--slider {
    color: $status-success;
}

Switch:focus > .switch--slider {
    color: $accent-secondary;
}

#settings-sections {
    background: $bg-base;
    height: 1fr;
}

.side-heading {
    color: $fg-muted;
    text-style: bold;
    margin-top: 1;
}

ListItem:disabled {
    opacity: 1;
}

.field-note {
    margin: 0 0 1 32;
    color: $fg-muted;
}

.settings-field.-noted {
    margin-bottom: 0;
}

DataTable {
    background: $bg-base;
    color: $fg-default;
    border: none;
}

DataTable > .datatable--header {
    background: $bg-base;
    color: $fg-muted;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $bg-selection;
    color: $fg-emphasis;
}

DataTable > .datatable--hover {
    background: $bg-surface;
}

OptionList, ListView, SelectionList {
    background: $bg-base;
    color: $fg-default;
    border: none;
    padding: 0;
}

OptionList:focus, ListView:focus, SelectionList:focus, DataTable:focus {
    border: none;
    background-tint: #000000 0%;
}

OptionList > .option-list--option-highlighted,
SelectionList > .option-list--option-highlighted {
    background: $bg-selection;
    color: $fg-emphasis;
    text-style: none;
}

OptionList > .option-list--option-hover,
SelectionList > .option-list--option-hover {
    background: $bg-surface;
}

ListItem {
    background: $bg-base;
    padding: 0 1;
}

ListItem.-highlight, ListView:focus > ListItem.-highlight {
    background: $bg-selection;
    color: $fg-emphasis;
}

ListView > ListItem.-hovered {
    background: $bg-surface;
}

/* ── Category colours ─────────────────────────────────────────────────── */

.cat-anime { color: $cat-anime; }
.cat-film_serie { color: $cat-film_serie; }
.cat-serie { color: $cat-serie; }
.cat-song { color: $cat-song; }
.cat-tor { color: $cat-tor; }
.cat-global { color: $cat-global; }

/* ── Shared text roles ────────────────────────────────────────────────── */

.panel-title, .box-title, .sub-title, .home-section-title {
    color: $fg-default;
    text-style: bold;
    padding: 0;
    margin-top: 1;
}

.muted { color: $fg-muted; }

/* ── Home ─────────────────────────────────────────────────────────────── */

#home-outer {
    align: center top;
    padding: 1 2;
}

#home-card {
    width: 100;
    max-width: 100%;
    height: auto;
    background: $bg-base;
    border: none;
    padding: 0;
}

#home-search-bar {
    height: 1;
    margin-bottom: 1;
}

#main-search-input {
    width: 1fr;
    margin-right: 1;
}

#btn-submit-search {
    width: auto;
    min-width: 12;
}

.home-section-title {
    text-align: left;
}

#home-provider-filter-bar {
    height: 1;
    margin-bottom: 1;
}

#provider-filter-input {
    width: 1fr;
}

/* Five pills side by side leave 8 usable cells each on an 80 column terminal,
   which is not enough for the labels: below that width they wrap onto two rows. */
#home-scope-pills {
    height: 1;
    margin-bottom: 1;
    grid-size: 5;
    grid-columns: 1fr 1fr 1fr 1fr 1fr;
    grid-rows: 1;
    grid-gutter: 0 1;
}

#home-scope-pills.-narrow {
    grid-size: 3;
    height: 3;
    grid-gutter: 1 1;
}

.scope-pill {
    width: 1fr;
    height: 1;
    margin: 0;
}

#home-sites-box {
    height: auto;
    max-height: 10;
    border: none;
    background: $bg-base;
    padding: 0;
    margin-bottom: 1;
}

#home-sites-wrap {
    height: auto;
    max-height: 8;
}

.site-pill-row {
    height: 1;
    margin-bottom: 0;
    align: left middle;
}

.site-dot {
    color: $fg-muted;
    width: 3;
    content-align: center middle;
}

Button.site-pill {
    min-width: 0;
    height: 1;
    padding: 0 1;
    margin: 0;
    border: none;
    background: transparent;
    color: $fg-default;
}

Button.site-pill:hover {
    color: $accent-secondary;
    background: $bg-surface;
}

Button.site-pill:focus {
    color: $accent-secondary;
    text-style: bold underline;
    background: $bg-selection;
}

Button.site-pill.-primary {
    background: $accent-primary;
    color: $bg-base;
    text-style: bold;
}

/* ── Search ───────────────────────────────────────────────────────────── */

#search-panel {
    padding: 1 2;
}

#search-inputs-bar {
    height: 1;
    margin-bottom: 1;
}

#search-inputs-bar Input#query {
    width: 2fr;
    margin-right: 1;
}

#search-inputs-bar Input#year {
    width: 1fr;
}

#category-filter-pills {
    height: 1;
    margin-bottom: 1;
    grid-size: 4;
    grid-columns: 1fr 1fr 1fr 1fr;
    grid-rows: 1;
    grid-gutter: 0 1;
}

.filter-pill {
    width: 1fr;
    height: 1;
    margin: 0;
}

#sort-btn {
    min-width: 16;
    height: 1;
    margin-left: 1;
    background: $bg-overlay;
    color: $accent-secondary;
}

#retry-failed-btn {
    min-width: 16;
    height: 1;
    margin-left: 1;
}

#search-loading {
    height: 1;
}

#search-status {
    color: $fg-muted;
    padding-bottom: 1;
}

#search-split {
    height: 1fr;
}

#results-container {
    width: 55%;
    height: 1fr;
    padding-right: 2;
}

#batch-actions-bar {
    height: 1;
    margin-top: 1;
    align: left middle;
    background: $bg-base;
    padding: 0;
    border: none;
}

#batch-count-label {
    width: auto;
    margin-right: 2;
    color: $status-success;
}

#btn-batch-enqueue {
    margin-right: 1;
}

#preview-container {
    width: 45%;
    height: 1fr;
}

#preview-box {
    height: 1fr;
    border: none;
    border-left: solid $bg-overlay;
    background: $bg-base;
    padding: 0 0 0 2;
}

#preview-head {
    height: auto;
    margin-bottom: 1;
}

#preview-head.-stacked {
    layout: vertical;
}

#search-preview-box {
    width: 1fr;
    height: auto;
    max-height: 16;
}

#preview-cover {
    margin-right: 2;
}

#preview-head.-stacked #preview-cover {
    margin-right: 0;
    margin-bottom: 1;
}

#preview-providers-box {
    height: auto;
    margin-bottom: 1;
}

.preview-prov-title {
    color: $fg-muted;
    text-style: none;
    margin-top: 0;
}

#preview-providers-wrap {
    height: auto;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1;
    grid-gutter: 0 1;
}

.preview-prov-pill {
    width: 1fr;
    height: 1;
    margin: 0;
}

#preview-actions-row {
    height: auto;
    margin-top: 1;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1;
    grid-gutter: 1 1;
}

#preview-actions-row Button {
    width: 1fr;
    height: 1;
    margin: 0;
}

FuzzyList {
    height: 1fr;
    width: 1fr;
}

#fuzzy-input {
    dock: top;
    margin-bottom: 1;
}

#fuzzy-list {
    height: 1fr;
    width: 1fr;
}

/* ── Detail ───────────────────────────────────────────────────────────── */

#detail-panel {
    padding: 1 2;
}

#detail-head {
    height: 1fr;
}

#detail-cover {
    margin-right: 3;
}

#detail-info {
    width: 1fr;
    height: 1fr;
}

.detail-title {
    text-style: bold;
    color: $fg-emphasis;
}

.detail-meta {
    color: $fg-muted;
}

#series-area {
    height: 1fr;
    padding-top: 1;
}

#seasons-loading {
    height: 1;
}

#series-browser {
    height: 1fr;
}

#providers-box {
    width: 22%;
    background: $bg-base;
    padding: 0 2 0 0;
}

#seasons-box {
    width: 22%;
    background: $bg-base;
    padding: 0 2 0 0;
}

#episodes-box {
    width: 56%;
    padding: 0;
}

.dsl-preview {
    color: $status-warning;
    padding: 1 0 0 0;
}

#actions-row {
    height: auto;
    padding: 1 0 0 0;
}

#actions-row Button {
    margin-right: 2;
}

/* ── Downloads / Queue / History ──────────────────────────────────────── */

#downloads-panel, #queue-panel, #history-panel {
    padding: 1 2;
}

#downloads-table, #completed-table, #queue-table, #history-table {
    height: 1fr;
    max-height: 50%;
    border: none;
    margin-bottom: 1;
}

#downloads-table, #completed-table {
    max-height: 45%;
}

#tasks-table {
    height: 1fr;
    border: none;
}

.queue-detail-box, .history-detail-box {
    height: 5;
    border: none;
    border-left: solid $accent-primary;
    background: $bg-base;
    padding: 0 2;
}

#downloads-actions, #queue-actions, #history-actions {
    height: auto;
    padding-top: 1;
}

#downloads-actions Button, #queue-actions Button, #history-actions Button {
    margin-right: 2;
}

/* ── Settings ─────────────────────────────────────────────────────────── */

#settings-sidebar {
    width: 28;
    dock: left;
    background: $bg-base;
    border: none;
    padding: 1 2 1 2;
}

#settings-content {
    width: 1fr;
    padding: 1 2;
    border-left: solid $bg-overlay;
}

#settings-form {
    height: 1fr;
    padding: 1 0;
}

.settings-banner {
    border: none;
    border-left: solid $status-warning;
    background: $bg-base;
    color: $status-warning;
    padding: 0 2;
    margin-bottom: 1;
}

.settings-field {
    height: auto;
    margin-bottom: 1;
    align: left middle;
}

.field-label {
    width: 32;
    color: $fg-muted;
}

#settings-actions {
    height: auto;
    padding: 1 0;
    align: left middle;
}

#settings-actions Button {
    margin-right: 2;
}

#settings-status {
    padding-left: 1;
    color: $status-success;
}

/* ── System ───────────────────────────────────────────────────────────── */

TabbedContent, TabPane {
    background: $bg-base;
}

Tabs {
    background: $bg-base;
}

Tab {
    background: $bg-base;
    color: $fg-muted;
}

Tab.-active {
    color: $accent-secondary;
    text-style: bold;
}

Underline > .underline--bar {
    color: $accent-primary;
    background: $bg-overlay;
}

#tab-deps, #tab-logs, #tab-updates {
    padding: 1 2;
}

#deps-table {
    height: auto;
    max-height: 12;
    border: none;
    margin-bottom: 1;
}

#drm-box {
    height: auto;
    padding: 0 2;
    border: none;
    border-left: solid $bg-overlay;
    background: $bg-base;
    margin-bottom: 1;
}

#log-control-bar {
    height: auto;
    margin-bottom: 1;
    align: left middle;
}

#log-control-bar Button {
    margin-left: 2;
}

#log-layout {
    height: 1fr;
}

#log-file-list {
    width: 32;
    dock: left;
    background: $bg-base;
    border: none;
}

#log-viewer {
    width: 1fr;
    height: 1fr;
    border: none;
    background: $bg-base;
}

#update-box {
    height: 1fr;
    padding: 0 2;
    border: none;
    border-left: solid $bg-overlay;
    background: $bg-base;
}

#system-info-text {
    margin-bottom: 1;
}

#update-status {
    padding-top: 1;
    color: $status-info;
}

/* ── Modals & help ────────────────────────────────────────────────────── */

PlaceholderScreen, HelpScreen, EnqueueModal, RangeSelectModal, TrackSelectModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

#tracks-list {
    height: auto;
    max-height: 20;
    margin: 1 0;
    background: $bg-surface;
}

#placeholder-box, #enqueue-modal-box, #range-modal-box, #tracks-modal-box {
    width: 68;
    max-width: 90%;
    height: auto;
    border: none;
    border-left: thick $accent-primary;
    padding: 1 2;
    background: $bg-surface;
}

#help-box {
    width: 74;
    max-width: 95%;
    max-height: 85%;
    border: none;
    border-left: thick $accent-primary;
    padding: 1 2;
    background: $bg-surface;
}

#help-scroll {
    max-height: 18;
}

.help-section-header {
    text-style: bold;
}

.placeholder-title {
    text-style: bold;
    color: $fg-emphasis;
    padding-bottom: 1;
}

.placeholder-milestone {
    color: $status-warning;
    padding-top: 1;
}

.placeholder-hint {
    color: $fg-muted;
    padding-top: 1;
}

#enqueue-input {
    margin: 1 0;
}

#modal-buttons {
    height: auto;
    padding-top: 1;
}

#modal-buttons Button {
    margin-right: 2;
}
